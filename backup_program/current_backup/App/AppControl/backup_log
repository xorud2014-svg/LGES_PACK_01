mkdir config_backup
cp -rf /root/system_data/config/* config_backup
tar cfz config_backup.tar.gz config_backup/*
rm -rf config_backup
echo "config_backup end"
sleep 1

cp -rf /root/system_data/log log_backup
tar cfz log_backup.tar.gz log_backup
