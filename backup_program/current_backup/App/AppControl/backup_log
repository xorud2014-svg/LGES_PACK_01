mv backup_mcts.tar.gz `cat $MODEL_NAME_FILE | awk '{if(NR==2) print $3}'`_backup_mcts_M`cat $MODEL_NAME_FILE | awk '{if(NR==3) print $3}'`_$DATE''_log.tar.gz

